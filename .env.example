# --- Application ---
APP_ENV=local
LOG_LEVEL=INFO
API_HOST=127.0.0.1
API_PORT=8000
API_BASE_URL=http://127.0.0.1:8000
WEB_BASE_URL=http://localhost:3000
# Additional browser origins allowed to call the API, comma-separated.
# The frontend is deployed to Netlify, where each site has its own
# `https://<site>.netlify.app` origin, and preview deploys add more.
# On the production VPS this holds the Netlify origin(s).
CORS_EXTRA_ORIGINS=

# --- Database (isolated CyberStratum instance on port 5433) ---
DATABASE_URL=postgresql+psycopg://cyberstratum_app:CHANGE_ME@127.0.0.1:5433/cyberstratum
# Separate database used by the pytest suite. Never point this at the dev DB.
TEST_DATABASE_URL=postgresql+psycopg://cyberstratum_app:CHANGE_ME@127.0.0.1:5433/cyberstratum_test
DB_POOL_SIZE=5
DB_MAX_OVERFLOW=10
DB_ECHO=false

# --- Queue ---
REDIS_URL=redis://127.0.0.1:6379
QUEUE_BACKEND=rq
QUEUE_PREFIX=cyberstratum
SCAN_QUEUE_NAME=scans
DISCOVERY_QUEUE_NAME=discovery
SANDBOX_QUEUE_NAME=sandbox
# Mythril and correspondence each have their own queue and their own
# worker, so neither can delay an ordinary scan.
MYTHRIL_QUEUE_NAME=mythril
CORRESPONDENCE_QUEUE_NAME=correspondence

# --- Auth (generate a real secret before deploying) ---
AUTH_SECRET=CHANGE_ME
# Static service API key. Clients send it in the API_KEY_HEADER header.
# The built-in default is a documented development value only.
API_KEY=dev-api-key-change-me
API_KEY_HEADER=X-API-Key
ACCESS_TOKEN_TTL_MINUTES=480
REFRESH_TOKEN_TTL_DAYS=30

# --- Object storage ---
OBJECT_STORAGE_DRIVER=local
OBJECT_STORAGE_ROOT=./var/artifacts
SIGNED_URL_TTL_SECONDS=300

# --- EVM / chain ---
EVM_CHAIN_ID=1
EVM_RPC_URL=
EVM_RPC_PROVIDER=public
EXPLORER_API_BASE_URL=
EXPLORER_API_KEY=

# --- Blockscout discovery -------------------------------------------------
# Optional. Only needed for the Blockscout PRO route, which covers the chains
# whose per-chain instance is blocked or missing. The per-chain instance route
# needs no key at all.
# Get one at https://account.blockscout.com/  (free tier: 100,000 credits/day,
# 20 credits per call, 10 items per page, max 3 concurrent requests).
BLOCKSCOUT_API_KEY=
DEFAULT_EVM_FORK=prague

# --- Scan pipeline ---
ENABLE_EXPERIMENTAL_ML=false
ML_MODEL_VERSION=
ML_MODEL_ARTIFACT_URI=
SCAN_MAX_BYTECODE_BYTES=2000000
SCAN_JOB_TIMEOUT_SECONDS=300
SCAN_MAX_RETRIES=3

# --- Source engine (optional) ------------------------------------------
# Slither is AGPL-3.0 and is never installed into this project's Python
# environment, never imported, and never vendored. It is run as an
# unmodified external executable and its JSON output is read across the
# process boundary (ADR-0013). Point this at the executable, or leave it
# empty and put the executable on PATH.
# The scan pipeline skips the source audit -- it does not fail the scan --
# when this cannot be found.
SLITHER_BIN=

# Where the solc binaries live. solc-select stores each compiler in its
# own versioned directory under this root.
SOLC_ARTIFACTS_DIR=~/.solc-select/artifacts

# --- Mythril (manual-only, AGPL) ---------------------------------------
# Mythril is MANUAL-ONLY by decision (ADR-0014): it is slow, and it never
# joins a default scan. It runs as an unmodified external executable from
# its own virtualenv, outside this project's Python environment.
#
# The console script is named `myth`, not `mythril`. When the binary cannot
# be found the manual action records an honest `mythril_not_installed`
# skip - never a clean result.
MYTHRIL_BIN=myth
MYTHRIL_TIMEOUT_SECONDS=300
MYTHRIL_SOLVER_TIMEOUT_MS=60000

# --- Source/bytecode correspondence (manual-only) ----------------------
# Recompiles the verified source with the exact compiler Sourcify recorded
# and compares the executable code. It has its own queue and worker, so a
# recompilation can never delay an ordinary scan.
CORRESPONDENCE_TIMEOUT_SECONDS=900
CORRESPONDENCE_COMPILE_TIMEOUT_SECONDS=600
CORRESPONDENCE_HTTP_TIMEOUT_SECONDS=60

# --- Sandbox (off until an isolated runner exists) ---
SANDBOX_ENABLED=false
SANDBOX_MAX_MEMORY_MB=512
SANDBOX_MAX_CPU_SECONDS=30
SANDBOX_MAX_WALL_SECONDS=120

# --- Observability ---
ERROR_TRACKING_DSN=
OTEL_EXPORTER_OTLP_ENDPOINT=
EMAIL_PROVIDER=disabled
