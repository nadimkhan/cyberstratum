{
  "name": "cyberstratum",
  "version": "0.1.0",
  "private": true,
  "description": "CyberStratum \u2014 bytecode-first EVM security analysis platform",
  "license": "MIT",
  "workspaces": [
    "apps/web"
  ],
  "scripts": {
    "generate:opcodes": "node scripts/generate_opcodes.mjs",
    "dev": "node scripts/dev.mjs",
    "stop": "node scripts/dev.mjs --stop",
    "logs": "node scripts/dev.mjs --logs",
    "lint": "node scripts/py.mjs -m ruff check apps packages tests scripts",
    "format:check": "node scripts/py.mjs -m ruff format --check apps packages tests scripts",
    "typecheck": "node scripts/py.mjs -m mypy apps packages && npm run typecheck --workspace @cyberstratum/web",
    "test": "npm run test:web && node scripts/py.mjs -m pytest -q",
    "test:web": "npm run test --workspace @cyberstratum/web",
    "test:py": "node scripts/py.mjs -m pytest -q",
    "build:web": "npm run build --workspace @cyberstratum/web",
    "dev:web": "npm run dev --workspace @cyberstratum/web",
    "start:web": "npm run start --workspace @cyberstratum/web",
    "typecheck:web": "npm run typecheck --workspace @cyberstratum/web",
    "migrate": "node scripts/py.mjs -m alembic upgrade head",
    "api": "node scripts/py.mjs -m uvicorn app.main:app --app-dir apps/api --host 127.0.0.1 --port 8000",
    "worker": "node scripts/py.mjs --cwd apps/api -m app.worker"
  },
  "devDependencies": {
    "@ethereumjs/common": "^10.1.3",
    "@ethereumjs/evm": "^10.1.3",
    "evm-opcodes": "^2.0.0"
  },
  "engines": {
    "node": ">=20"
  }
}
