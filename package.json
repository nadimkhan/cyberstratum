{
  "name": "cyberstratum",
  "version": "0.1.0",
  "private": true,
  "description": "CyberStratum — bytecode-first EVM security analysis platform",
  "license": "MIT",
  "workspaces": [
    "apps/web"
  ],
  "scripts": {
    "generate:opcodes": "node scripts/generate_opcodes.mjs",
    "lint": "ruff check apps packages tests scripts",
    "typecheck": "mypy apps packages && npm run typecheck --workspace @cyberstratum/web",
    "test": "npm run test:web && pytest",
    "test:web": "npm run test --workspace @cyberstratum/web",
    "build:web": "npm run build --workspace @cyberstratum/web",
    "dev:web": "npm run dev --workspace @cyberstratum/web",
    "typecheck:web": "npm run typecheck --workspace @cyberstratum/web"
  },
  "devDependencies": {
    "@ethereumjs/common": "^10.1.3",
    "@ethereumjs/evm": "^10.1.3",
    "evm-opcodes": "^2.0.0"
  },
  "engines": {
    "node": ">=20"
  }
}
