# Production environment for the CyberStratum backend on a Linux VPS.
#
# Copy to /etc/cyberstratum/app.env, fill in the real values, then:
#   sudo chown root:cyberstratum /etc/cyberstratum/app.env
#   sudo chmod 640 /etc/cyberstratum/app.env
#
# Every value the service reads comes from this file. The application does
# NOT read the repository's .env file in production: the systemd units use
# EnvironmentFile, so the deployed configuration is explicit and auditable.
#
# Generate the secrets with:  openssl rand -hex 32

# --- Application ---------------------------------------------------------
APP_ENV=production
LOG_LEVEL=INFO
# The API binds to loopback; a TLS-terminating reverse proxy (Caddy, nginx)
# is the only thing that faces the internet. See deploy/vps/Caddyfile.
API_HOST=127.0.0.1
API_PORT=8000
# The PUBLIC URL of the API. The frontend and the report links use it.
API_BASE_URL=https://api.example.com
# The public URL of the deployed frontend (Netlify).
WEB_BASE_URL=https://cyberstratum.netlify.app
# Comma-separated browser origins allowed to call the API. Put the deployed
# Netlify origin here, plus any custom domain the frontend is served from.
CORS_EXTRA_ORIGINS=https://cyberstratum.netlify.app

# --- Database ------------------------------------------------------------
# The production database. Managed PostgreSQL or a local cluster; the
# backend only needs this connection string.
DATABASE_URL=postgresql+psycopg://cyberstratum_app:CHANGE_ME@127.0.0.1:5432/cyberstratum
DB_POOL_SIZE=5
DB_MAX_OVERFLOW=10
DB_ECHO=false

# --- Queue ---------------------------------------------------------------
# Redis holds the RQ queues. A dedicated instance is strongly preferred:
# the queue data is disposable, but a flush would discard in-flight jobs.
REDIS_URL=redis://127.0.0.1:6379
QUEUE_BACKEND=rq
QUEUE_PREFIX=cyberstratum
SCAN_QUEUE_NAME=scans
DISCOVERY_QUEUE_NAME=discovery
SANDBOX_QUEUE_NAME=sandbox
MYTHRIL_QUEUE_NAME=mythril
CORRESPONDENCE_QUEUE_NAME=correspondence

# --- Auth ----------------------------------------------------------------
# Long random secrets. Generate with `openssl rand -hex 32`.
AUTH_SECRET=CHANGE_ME
# Static service API key. Clients send it in the API_KEY_HEADER header.
# This key is an ADMINISTRATIVE credential: it is not scoped to a
# workspace. See docs/DEPLOYMENT.md before handing it to anyone.
API_KEY=CHANGE_ME
API_KEY_HEADER=X-API-Key
ACCESS_TOKEN_TTL_MINUTES=480
REFRESH_TOKEN_TTL_DAYS=30

# --- Object storage ------------------------------------------------------
# Scan artifacts (bytecode, source, reports) live on disk. On the VPS this
# must be the writable state directory, NOT the repository: the systemd
# units run with ProtectSystem=strict.
OBJECT_STORAGE_DRIVER=local
OBJECT_STORAGE_ROOT=/var/lib/cyberstratum/artifacts
SIGNED_URL_TTL_SECONDS=300

# --- EVM / chain ---------------------------------------------------------
EVM_CHAIN_ID=1
EVM_RPC_URL=
EVM_RPC_PROVIDER=public
EXPLORER_API_BASE_URL=
EXPLORER_API_KEY=
# Fork used when the scan does not state one. Keep this in step with the
# fork the chain is actually at.
DEFAULT_EVM_FORK=prague

# --- Blockscout discovery ------------------------------------------------
# Optional. Only the Blockscout PRO route needs a key; the per-chain
# instance route needs none. Free tier: 100,000 credits/day.
BLOCKSCOUT_API_KEY=

# --- Scan pipeline -------------------------------------------------------
ENABLE_EXPERIMENTAL_ML=false
ML_MODEL_VERSION=
ML_MODEL_ARTIFACT_URI=
SCAN_MAX_BYTECODE_BYTES=2000000
SCAN_JOB_TIMEOUT_SECONDS=300
SCAN_MAX_RETRIES=3

# --- Slither (optional, AGPL-3.0) ---------------------------------------
# Slither is AGPL-3.0: it is never installed into this project's Python
# environment, never imported, never vendored. It is run as an unmodified
# external executable and its JSON output is read across the process
# boundary (ADR-0013). Leave it empty to skip the source audit entirely;
# the scan then reports the source audit as SKIPPED, never as clean.
# The AGPL network clause still needs legal sign-off before a commercial
# multi-tenant launch - see docs/PENDING.md section 4.4.
SLITHER_BIN=
SOLC_ARTIFACTS_DIR=/var/lib/cyberstratum/solc

# --- Mythril (optional, manual-only) ------------------------------------
# Mythril is MANUAL-ONLY by decision (ADR-0014): it is slow, and it never
# joins a default scan. It runs out of process, from its own virtualenv,
# outside this application's Python environment.
#
# Leave MYTHRIL_BIN empty (or point it at a missing path) and the manual
# action records an honest `mythril_not_installed` skip. The console script
# is named `myth`, not `mythril`.
MYTHRIL_BIN=/opt/cyberstratum/mythril-venv/bin/myth
MYTHRIL_TIMEOUT_SECONDS=300
MYTHRIL_SOLVER_TIMEOUT_MS=60000

# --- Source/bytecode correspondence (optional, manual-only) -------------
# Recompiles verified source with the exact compiler Sourcify recorded and
# compares executable code. It has its own queue and worker so a
# recompilation can never delay an ordinary scan.
CORRESPONDENCE_TIMEOUT_SECONDS=900
CORRESPONDENCE_COMPILE_TIMEOUT_SECONDS=600
CORRESPONDENCE_HTTP_TIMEOUT_SECONDS=60

# --- Sandbox (off until an isolated runner exists) ----------------------
SANDBOX_ENABLED=false
SANDBOX_MAX_MEMORY_MB=512
SANDBOX_MAX_CPU_SECONDS=30
SANDBOX_MAX_WALL_SECONDS=120

# --- Observability -------------------------------------------------------
ERROR_TRACKING_DSN=
OTEL_EXPORTER_OTLP_ENDPOINT=
EMAIL_PROVIDER=disabled
